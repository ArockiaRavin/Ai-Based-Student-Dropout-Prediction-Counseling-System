# EduRetain AI Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Database configuration (defaults to local SQLite if omitted)
DATABASE_URL=sqlite:///student_retention.db
# For PostgreSQL / Supabase cloud deployment:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Security / Authentication
JWT_SECRET=replace-with-secure-32-char-random-string
SECRET_KEY=replace-with-secure-32-char-random-string

# Machine Learning & Retention Settings
ACTIVE_ML_MODEL=Random Forest
HIGH_RISK_THRESHOLD=65.0
MEDIUM_RISK_THRESHOLD=35.0

